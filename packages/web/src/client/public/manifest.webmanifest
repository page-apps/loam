{
  "name": "Loam — local-first outliner",
  "short_name": "Loam",
  "description": "A mobile-first block outliner for a local folder or private GitHub graph.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f7f2",
