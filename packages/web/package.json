{
  "name": "@loam/web",
  "version": "0.1.0",
  "description": "Loam mobile-first outliner for local-folder and private-GitHub graphs",
  "keywords": [
    "logseq",
    "pwa",
    "github-pages",
    "preact"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "loam-web": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "prepare": "tsc -b && vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome check --write src test",
    "lint:ci": "biome check src test",
    "format": "biome format --write src test",
    "format:check": "biome format src test"
  },
  "dependencies": {
    "@loam/core": "workspace:*",
    "express": "^5.2.1",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/supertest": "latest",
    "cpy-cli": "latest",
    "supertest": "latest",
    "vite": "^8.2.2",
    "vitest": "latest"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/page-apps/loam.git",
    "directory": "packages/web"
  },
  "license": "MIT"
}
